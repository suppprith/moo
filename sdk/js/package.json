{
  "name": "moo-js",
  "version": "0.1.0",
  "description": "Official JavaScript/TypeScript SDK for moo: search infrastructure for AI agents",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "search",
    "agents",
    "llm",
    "rag",
    "web-search",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suppprith/moo.git",
    "directory": "sdk/js"
  },
  "homepage": "https://github.com/suppprith/moo/tree/main/sdk/js",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
