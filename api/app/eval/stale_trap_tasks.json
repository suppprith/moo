    "deprecated",
    "removed in",
    "was removed",
    "no longer",
    "superseded",
    "obsolete",
    "replaced by",
    "instead of",
    "legacy",
    "outdated",
    "not recommended",
    "since version",
    "as of ",
    "renamed",
    "retired",
    "retirement",
    "end of life"
  ],
