# Copy to api/.env (gitignored) and set your provider. The LLM stages (query
# expansion, claim/evidence extraction, synthesis) use whatever you configure;
# without any key they fall back to deterministic heuristics and the pipeline
# still runs end to end.

# --- Bring your own key: pick ONE provider ---

# Gemini (default if a Google key is present)
GEMINI_API_KEY=your-key-here

# OpenAI
# MOO_LLM_PROVIDER=openai
# MOO_LLM_API_KEY=sk-...

# Anthropic (Claude)
# MOO_LLM_PROVIDER=anthropic
# MOO_LLM_API_KEY=sk-ant-...

# Any OpenAI-compatible server (vLLM, LM Studio, llama.cpp, a gateway)
# MOO_LLM_PROVIDER=openai-compatible
# MOO_LLM_BASE_URL=http://localhost:8000/v1
# MOO_LLM_API_KEY=optional

# Local Ollama (no key needed)
# MOO_LLM_PROVIDER=ollama
# MOO_LLM_MODEL=llama3.1
# MOO_LLM_BASE_URL=http://localhost:11434/v1   # default

# Optional: override the model for any provider
# MOO_LLM_MODEL=gemini-2.5-flash

# --- Live web search: pick ONE discovery provider ---
# Without either, moo serves its local store/cache only.

# Self-hosted SearXNG (keyless): docker run -d -p 8888:8080 searxng/searxng
# then enable the JSON format in its settings.yml (search: formats: [html, json])
# MOO_SEARXNG_URL=http://localhost:8888

# Brave Search API (free tier): https://brave.com/search/api/
# MOO_BRAVE_API_KEY=BSA...

# Explicit choice / kill switch: searxng | brave | off
# MOO_SEARCH_PROVIDER=searxng

# --- Live-fetch budget knobs ---
# MOO_LIVE_MAX_SECONDS=12        # wall-clock deadline on the fetch stage
# MOO_CACHE_MAX_DOCS=0           # live-doc cache bound (0 = unbounded)

# --- Reranker backend: llm (default) | cross | off ---
# cross = local cross-encoder, no API key, ~90MB model on first use
# MOO_RERANKER=cross
# MOO_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
