          {
            "description": "live web fetch (default auto; false = store only)",
            "in": "query",
            "name": "live",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "live web fetch (default auto; false = store only)",
              "title": "Live"
