                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Web Search Get"
      },
      "post": {
        "description": "Drop-in web search for coding agents: point your agent's `web_search` tool\nhere and get software-specialist `{title, url, snippet}` results fetched\nlive from the web (plus moo's evidence layer as optional fields).\n`depth=raw` (default) makes zero LLM calls. Register `GET /v1/tools` as the\ntool definition.",
