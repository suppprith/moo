{
  "components": {
    "schemas": {
      "ExtractRequest": {
        "properties": {
          "depth": {
            "default": "raw",
            "enum": [
              "raw",
              "claims"
            ],
            "title": "Depth",
            "type": "string"
          },
          "force": {
            "default": false,
            "description": "bypass the TTL cache and re-fetch",
            "title": "Force",
            "type": "boolean"
          },
          "urls": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 1,
            "title": "Urls",
            "type": "array"
          }
        },
        "required": [
          "urls"
        ],
        "title": "ExtractRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ResearchRequest": {
        "properties": {
          "k": {
            "default": 6,
            "description": "retrieval depth per sub-question",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "K",
            "type": "integer"
          },
          "max_seconds": {
            "default": 60.0,
            "description": "wall-clock budget",
            "maximum": 300.0,
            "minimum": 5.0,
            "title": "Max Seconds",
            "type": "number"
          },
          "max_steps": {
            "default": 6,
            "description": "hard cap on retrieve+extract cycles",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Max Steps",
            "type": "integer"
          },
          "output_schema": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "JSON schema for a caller-shaped `structured` section; every populated field is traced to claim handles (`structured.grounding`), untraceable fields are null, never fabricated",
            "title": "Output Schema"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "use_llm": {
            "default": true,
            "description": "use the LLM stages (falls back to heuristic keyless)",
            "title": "Use Llm",
            "type": "boolean"
          }
        },
        "required": [
          "question"
        ],
        "title": "ResearchRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WebSearchRequest": {
        "properties": {
          "depth": {
            "default": "raw",
            "enum": [
              "raw",
              "claims",
              "full"
            ],
            "title": "Depth",
            "type": "string"
          },
          "live": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Live"
          },
          "max_results": {
            "default": 8,
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Max Results",
            "type": "integer"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "shape": {
            "default": "web",
            "enum": [
              "web",
              "anthropic"
            ],
            "title": "Shape",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "WebSearchRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Live search, evidence and deep research for AI agents. Endpoints: `/search` (ranked evidence), `/v1/web_search` (drop-in web_search shape), `/research` (deep research), fetch/drill-down (`/source|/chunk|/claim/{id}`), `/graph`. Opaque handles: `chk_`/`doc_`/`clm_`/`ent_`. Errors use a structured envelope with a stable `code`. See `/contract` for the machine-readable descriptor and the MCP tool schemas.",
    "license": {
      "name": "MIT",
      "url": "https://github.com/suppprith/moo/blob/main/LICENSE"
    },
    "summary": "Search infrastructure for AI agents",
    "title": "moo",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/account/usage": {
      "get": {
        "description": "Credits and per-endpoint usage for the presented key. Requires the key\nitself, so one key can never see another's usage.",
        "operationId": "account_usage_account_usage_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Account Usage Account Usage Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Account Usage"
      }
    },
    "/chunk/{id}": {
      "get": {
        "description": "A chunk with full text, its document handle, and surrounding-chunk context.\nAccepts a `chk_<id>` handle (as emitted in agent-format sources) or bare rowid.",
        "operationId": "chunk_endpoint_chunk__id__get",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "title": "Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Chunk Endpoint Chunk  Id  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Chunk Endpoint"
      }
    },
    "/claim/{id}": {
      "get": {
        "description": "A claim with confidence + its full evidence set (contradictions first) and\nextraction provenance. Accepts a `clm_<id>` handle or bare rowid.",
        "operationId": "claim_endpoint_claim__id__get",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "title": "Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Claim Endpoint Claim  Id  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Claim Endpoint"
      }
    },
    "/contract": {
      "get": {
        "description": "Machine-readable descriptor: contract version, the OpenAPI URL, the handle\nformats, and the MCP tool schemas \u2014 one place for an agent to introspect moo.",
        "operationId": "contract_contract_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Contract Contract Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Contract"
      }
    },
    "/graph": {
      "get": {
        "description": "Subgraph-for-query: seed entities from the query, their neighborhood, and\nthe claims attached to each node/edge. Sized for rendering (capped,\nexpandable via /graph/expand).",
        "operationId": "graph_graph_get",
        "parameters": [
          {
            "description": "natural-language query",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "natural-language query",
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "depth",
            "required": false,
            "schema": {
              "default": 1,
              "maximum": 3,
              "minimum": 1,
              "title": "Depth",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cap",
            "required": false,
            "schema": {
              "default": 60,
              "maximum": 300,
              "minimum": 1,
              "title": "Cap",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Graph Graph Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Graph"
      }
    },
    "/graph/expand": {
      "get": {
        "description": "The next ring of edges for a node, for click-to-expand in the explorer.",
        "operationId": "graph_expand_graph_expand_get",
        "parameters": [
          {
            "description": "entity id or name",
            "in": "query",
            "name": "node",
            "required": true,
            "schema": {
              "description": "entity id or name",
              "title": "Node",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 100,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Graph Expand Graph Expand Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Graph Expand"
      }
    },
    "/health": {
      "get": {
        "description": "Liveness probe, and the endpoint an uptime monitor should watch. Stays\nreachable without a key so a monitor never needs one. `errors_5xx_recent`\nis the count inside the alert window, which is what a spike rule fires on.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/metrics": {
      "get": {
        "description": "Per-route p50/p95 latency and status counts over a rolling window, for a\nstatus page or a scrape. Aggregate only: no query, no key, no client.",
        "operationId": "metrics_endpoint_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Metrics Endpoint Metrics Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics Endpoint"
      }
    },
    "/research": {
      "post": {
        "description": "Run a full deep-research run (plan -> iterative loop -> cited report) and\nreturn the structured report. Budget is enforced end-to-end; a run that hits\na cap returns `status: partial`. Use POST /research/stream for progress, or\nGET /research/{id} to re-fetch. Pass `output_schema` (a JSON schema) to also\nget a caller-shaped `structured` section with per-field claim grounding.",
        "operationId": "research_post_research_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Research Post Research Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Research Post"
      }
    },
    "/research/stream": {
      "post": {
        "description": "Streaming (SSE) deep research: emits `plan`, a `progress` event per step\n(with why it was spawned), then a terminal `report` + `done` \u2014 or `error`.\nReuses the app.streaming event contract.",
        "operationId": "research_stream_research_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Research Stream"
      }
    },
    "/research/{run_id}": {
      "get": {
        "description": "Fetch a run's status + cited report for polling/resume. The report is\nreassembled deterministically (no LLM) from the persisted evidence.",
        "operationId": "research_get_research__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Research Get Research  Run Id  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Research Get"
      }
    },
    "/search": {
      "get": {
        "description": "Unified pipeline. `mode=raw` (default) makes zero LLM calls; `claims` adds\nthe evidence layer + query subgraph; `full` adds a cited synthesized answer.\nWith a search provider configured, results come from the live web (fast mode\n= live snippets, deep modes = live + evidence); `meta.live` reports it.\n\n`format=agent` returns a compact, handle-addressed payload for AI agents;\n`fields` selects sections; `offset`/`cursor` paginate `sources`.",
        "operationId": "search_endpoint_search_get",
        "parameters": [
          {
            "description": "the search query",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "the search query",
              "title": "Q",
              "type": "string"
            }
          },
          {
            "description": "raw=pure retrieval (no LLM); claims=+evidence; full=+synthesis",
            "in": "query",
            "name": "mode",
            "required": false,
            "schema": {
              "default": "raw",
              "description": "raw=pure retrieval (no LLM); claims=+evidence; full=+synthesis",
              "enum": [
                "raw",
                "claims",
                "full"
              ],
              "title": "Mode",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "k",
            "required": false,
            "schema": {
              "default": 10,
              "maximum": 50,
              "minimum": 1,
              "title": "K",
              "type": "integer"
            }
          },
          {
            "description": "full=UI contract; agent=compact, opaque handles, evidence-by-reference",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "default": "full",
              "description": "full=UI contract; agent=compact, opaque handles, evidence-by-reference",
              "enum": [
                "full",
                "agent"
              ],
              "title": "Format",
              "type": "string"
            }
          },
          {
            "description": "comma-separated sections to include: sources,claims,graph,answer,citations",
            "in": "query",
            "name": "fields",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "comma-separated sections to include: sources,claims,graph,answer,citations",
              "title": "Fields"
            }
          },
          {
            "description": "pagination offset into the sources list",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "description": "pagination offset into the sources list",
              "maximum": 200,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "description": "opaque pagination cursor from meta.page.next_cursor (overrides offset)",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "opaque pagination cursor from meta.page.next_cursor (overrides offset)",
              "title": "Cursor"
            }
          },
          {
            "description": "fetch fresh pages from the live web first (default: auto when a search provider is configured; false = local store only)",
            "in": "query",
            "name": "live",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "fetch fresh pages from the live web first (default: auto when a search provider is configured; false = local store only)",
              "title": "Live"
            }
          },
          {
            "description": "add best-span highlights + 0-1 relevance to each source",
            "in": "query",
            "name": "highlights",
            "required": false,
            "schema": {
              "default": false,
              "description": "add best-span highlights + 0-1 relevance to each source",
              "title": "Highlights",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Search Endpoint Search Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Endpoint"
      }
    },
    "/search/stream": {
      "get": {
        "description": "Streaming (SSE) variant of /search: emits a `progress` event, then one\n`source` (and `claim`) event per row, then a terminal `done`. A failure\nmid-stream arrives as a terminal `error` event (see app.streaming).",
        "operationId": "search_stream_endpoint_search_stream_get",
        "parameters": [
          {
            "description": "the search query",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "the search query",
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "mode",
            "required": false,
            "schema": {
              "default": "raw",
              "enum": [
                "raw",
                "claims",
                "full"
              ],
              "title": "Mode",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "k",
            "required": false,
            "schema": {
              "default": 10,
              "maximum": 50,
              "minimum": 1,
              "title": "K",
              "type": "integer"
            }
          },
          {
            "description": "comma-separated sections to include",
            "in": "query",
            "name": "fields",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "comma-separated sections to include",
              "title": "Fields"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Search Stream Endpoint Search Stream Get"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Stream Endpoint"
      }
    },
    "/source/{id}": {
      "get": {
        "description": "Full document behind a source: cleaned text + metadata + chunk handles.\nAccepts a `doc_<id>` handle or bare rowid.",
        "operationId": "source_endpoint_source__id__get",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "title": "Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Source Endpoint Source  Id  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Source Endpoint"
      }
    },
    "/usage": {
      "get": {
        "description": "Per-key request counts. `usage` is this process's masked in-memory tally;\n`keys` is the persisted per-key counters for issued keys. Requires a valid\nkey when auth is on.",
        "operationId": "usage_usage_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Usage Usage Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Usage"
      }
    },
    "/v1/extract": {
      "post": {
        "description": "Fetch URL(s) and return each page as clean markdown with `doc_`/`chk_`\nhandles into the store. `depth=claims` also runs the evidence layer per\npage (claims + confidence + contradictions \u2014 no other extract endpoint does\nthis). Failures are per-URL: each failed entry carries a structured\n`error`, the rest of the batch still returns. Content is untrusted\nthird-party data (see `notice`).",
        "operationId": "extract_post_v1_extract_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractRequest"
              }
            }
